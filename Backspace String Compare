class Solution {
public:

    string solve(string s){
        string s1="";
          int c=0;
        for(int i=s.size()-1;i>=0;i--){  
            if (s[i] == '#') {
            ++c;
        } else {
            if (c > 0) {
                --c;
            } else {
                s1 += s[i];
            }
        }
        }
        return s1;
    }

    bool backspaceCompare(string s, string t) {
        return solve(s)==solve(t);
        
    }
};
