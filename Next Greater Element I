class Solution {
public:
    vector<int> nextGreaterElement(vector<int>& nums1, vector<int>& nums2) {
        stack<int> s;
        s.push(-1);
        map<int,int> m;
        vector<int> ans(nums1);
        for(int i=nums2.size()-1;i>=0;i--){
            while(!s.empty() && s.top()!=-1 && s.top()<=nums2[i]){
                s.pop();
            }
            m[nums2[i]]=s.top();
            s.push(nums2[i]);
        }
        for(int i=0;i<nums1.size();i++){
            ans[i]=m[nums1[i]];
        }
        return ans;
    }
};
