bool isSameTree(TreeNode* r1, TreeNode* r2) {
        if(r1==NULL && r2==NULL){
            return true;
        }
        if((r1==NULL && r2!=NULL) || (r1!=NULL && r2==NULL)){
            return false;
        }
        if(r1->val!=r2->val){
            return false;
        }
        bool left=isSameTree(r1->left,r2->left);
        bool right=isSameTree(r1->right,r2->right);
        if(right && left){
            return true;
        }
        return false;
    }
