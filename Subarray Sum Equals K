class Solution {
public:
    int subarraySum(vector<int>& nums, int k) {
        map<int,int> m;
        m[0]=1;
        int sum=0;
        int count=0;
        for(int i=0;i<nums.size();i++){
            sum+=nums[i]; // count the sum
            if(m.find(sum-k)!=m.end()){
                count+=m[sum-k]; // if sum-k is there in map add its value to count    
            }
            m[sum]+=1; // storing prefix sum
        }
        return count;
    }
};
