class Solution {
public:

    int solve(vector<int> prices, int buy,int index,map<int,int> &m){
        if(index==prices.size()){
            return 0;
        }
        int profit=0;
        if()
        if(buy){
            // if buying then take max profit from buying now and selling the next one or waiting for now and buying the next stock
            profit=max(-prices[index]+solve(prices,0,index+1), solve(prices,1,index+1));
        }
        else{
            //if selling then take max profit from selling now and buying next or waiting to sell until next one
            profit=max(prices[index]+solve(prices,1,index+1), solve(prices,0,index+1));
        }
        return profit;
    }

    int maxProfit(vector<int>& prices) {
        map<int,int> m;
        return solve(prices,1,0,m);

    }
};
