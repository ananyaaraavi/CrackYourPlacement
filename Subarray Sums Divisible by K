class Solution {
public:
    int subarraysDivByK(vector<int>& nums, int k) {
        map<int,int> m;
        int count=0;
        int sum=0;
        m[0]=1;
        for(int i=0;i<nums.size();i++){
            sum+=nums[i];
            int mod = (sum % k + k) % k; // make sure it is always positive
            if(m.find(mod)!=m.end()){
                count+=m[mod];
            }
            m[mod]+=1;
        }
        return count;
    }
};
